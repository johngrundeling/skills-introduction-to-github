# BioKissed funnel — configuration reference (NAMES ONLY; do not put real secrets here).
#
# WHERE THESE ACTUALLY GO:
#   * Production secrets  -> Cloudflare dashboard (Pages project + reconcile worker)
#                            Settings -> Environment variables (mark SECRET as "encrypted").
#   * Local testing only  -> copy this file to ".dev.vars" (git-ignored) for `wrangler pages dev`.
#   * Never commit real values. .env, .dev.vars and *.secret are git-ignored.

# --- SECRETS (encrypted env vars in Cloudflare; never in the repo/chat) ---
PAYSTACK_SECRET_KEY=      # sk_test_... then sk_live_...
GHL_API_TOKEN=           # GHL Private Integration token for the BioKissed SA location

# --- NON-SECRET (plain env vars; safe to share) ---
GHL_LOCATION_ID=         # BioKissed SA location id  (NOT Career Legends)
GHL_PIPELINE_ID=         # BioKissed orders pipeline id
GHL_STAGE_ID=            # target stage id (e.g. "Paid")
PAYSTACK_CHANNELS=       # optional; blank = show ALL enabled channels (card, eft, apple_pay, capitec…)

# --- Cloudflare bindings (already created; ids for reference) ---
# D1  biokissed-orders  = a02ffd09-0bca-4787-ab7d-1219a7b6c5d8   (binding: DB)
# KV  biokissed-funnel  = 74d5ca6b2b5842528c696302ad6ff63a       (binding: KV)
